# Chimera — Umgebungskonfiguration (Vorlage)
#
# Installationsort: /opt/chimera/config/.env — vom systemd-Dienst gelesen
# (EnvironmentFile). Vorhandene Werte werden vom Installer NIE
# überschrieben; die Vorlage liegt daneben als /opt/chimera/config/.env.example.
#
# Alle Anbieter sind optional. Fehlt oder stimmt ein Wert, meldet der
# Connector sich als nicht verfügbar (`python -m chimera --pruefen`
# nennt ihn) — Chimera läuft trotzdem, nur ohne den Anbieter.
#
# Platzhalter stehen absichtlich drin und bedeuten "nicht gesetzt".
# Echte Werte gehören hierher, nie ins Repo.

# --- Ollama im eigenen Netz ---
# Adresse des Ollama-Servers, z. B. http://192.0.2.10:11434 (Beispiel, TEST-NET)
OLLAMA_API_BASE=http://dein-server:11434
# Standardmodell (optional), z. B. llama3.2:3b
OLLAMA_MODEL=

# --- Anthropic (API-Schlüssel) ---
ANTHROPIC_API_KEY=

# --- Anthropic (Abo über Claude-CLI) ---
# Vorher mit der Claude-CLI anmelden; das Token wird von ihr gesetzt.
ANTHROPIC_OAUTH_TOKEN=

# --- Telegram (optional) ---
# Token vom BotFather; ohne Token läuft der Kanal nicht.
CHIMERA_TELEGRAM_TOKEN=
# Wer den Bot benutzen darf: Nutzer-IDs, kommagetrennt.
# Leert den Filter niemand; das ist für die Einrichtung gedacht.
CHIMERA_TELEGRAM_ALLOWED=

# --- Web-Oberfläche (optional, im Gateway) ---
# Hash des Passworts: echo 'MeinPasswort' | chimera-tor --passwort-hash
# Ohne Hash läuft die Oberfläche nicht.
CHIMERA_WEB_PASSWORT_HASH=
# Port (Voreinstellung 8080) und Adresse (Voreinstellung 0.0.0.0).
CHIMERA_WEB_PORT=
CHIMERA_WEB_BIND=
