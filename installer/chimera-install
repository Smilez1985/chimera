#!/bin/sh
# Chimera -- Installer, Haupteinstieg.
#
# Ruft die Schritte in `steps/` der Nummer nach auf. Jeder Lauf schreibt
# ein Protokoll, auch ein erfolgreicher.
#
# Aufruf:
#   chimera-install                  alle Module
#   chimera-install --only 10        nur Modul 10 (Praefix genuegt)
#   chimera-install --list           Module auflisten
#   chimera-install --dry-run        nur berichten, nichts aendern
#   chimera-install --check          Zustand pruefen, Exitcode sprechend
#   chimera-install --log-dir DIR    Ablage des Protokolls
#
# Exitcode: der des ersten fehlgeschlagenen Moduls, sonst 0.
#           Stand ein Schritt auf "Neustart noetig" und war sonst alles in
#           Ordnung, ist es 3 -- fertig ist der Lauf dann naemlich nicht.
#           Ein echter Fehler schlaegt den Neustartwunsch.

set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/common.sh"

MODE=run
ONLY=""
VERSION="$(cat "$HERE/../VERSION" 2>/dev/null || echo '?')"

usage() {
	cat <<EOF
chimera-install $VERSION

  --only <praefix>   nur das passende Modul (z. B. 10, oder 10-check-system)
  --list             verfuegbare Module anzeigen
  --dry-run          nichts aendern, nur berichten
  --check            nur pruefen, Exitcode sagt den Zustand
  --log-dir <dir>    wohin das Protokoll geschrieben wird
  --downgrade=true   aelteren Stand bewusst nach source/ uebernehmen
  --mit <gruppe>     Opt-in-Recht fuer den Dienstnutzer (i2c, video)
  -h, --help         diese Hilfe
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--only)    ONLY="${2:?--only braucht einen Wert}"; shift 2 ;;
		--dry-run) MODE=dry;   shift ;;
		--check)   MODE=check; shift ;;
		--list)    MODE=list;  shift ;;
		--log-dir) CHIMERA_LOG_DIR="${2:?--log-dir braucht einen Wert}"; shift 2 ;;
		--downgrade=true)  CHIMERA_DOWNGRADE=true; shift ;;
		--downgrade=false) CHIMERA_DOWNGRADE=false; shift ;;
		--mit)
			case "${2:-}" in
				i2c|video) CHIMERA_MIT="${CHIMERA_MIT:+$CHIMERA_MIT }$2" ;;
				*) err "--mit kennt nur: i2c video"; exit 2 ;;
			esac
			shift 2 ;;
		-h|--help) usage; exit 0 ;;
		*) err "Unbekannte Option: $1"; usage >&2; exit 2 ;;
	esac
done

export CHIMERA_DOWNGRADE="${CHIMERA_DOWNGRADE:-false}" CHIMERA_MIT="${CHIMERA_MIT:-}"

# Die Argumente fuer den Neustart aus source/ (I8) festhalten -- nach der
# Schleife oben sind sie verbraucht.
ARGS_NEU=""
[ "$MODE" = dry ] && ARGS_NEU="$ARGS_NEU --dry-run"
[ "$MODE" = check ] && ARGS_NEU="$ARGS_NEU --check"
[ -n "$ONLY" ] && ARGS_NEU="$ARGS_NEU --only $ONLY"

steps_list() {
	# Nummerisch sortiert, damit 10 vor 90 kommt.
	find "$HERE/steps" -name '[0-9]*-*.sh' 2>/dev/null | sort
}

if [ "$MODE" = list ]; then
	printf 'Verfuegbare Module:\n'
	steps_list | while read -r m; do printf '  %s\n' "$(basename "$m" .sh)"; done
	exit 0
fi

log_open "install" || warn "Kein Protokoll moeglich -- Lauf wird nicht festgehalten."

log "chimera-install $VERSION"
case "$MODE" in
	dry)   info "Trockenlauf -- es wird nichts geaendert." ;;
	check) info "Pruefung -- es wird nichts geaendert." ;;
esac
[ -n "$ONLY" ] && info "Nur Modul: $ONLY"
log ""

FAILED=0
FIRST_RC=0
# Ein Befund aus Schritt 00 vor dem Neustart (aelterer Startbaum abgelehnt)
# zaehlt mit -- sonst verschwaende er im exec (stiller Erfolg).
if [ -f "$CHIMERA_LOG_DIR/.befund-quelle" ] && [ "${CHIMERA_NEU_GESTARTET:-0}" = 1 ]; then
	warn "Quelle: $(cat "$CHIMERA_LOG_DIR/.befund-quelle")"
	FAILED=1; FIRST_RC=1
fi
rm -f "$CHIMERA_LOG_DIR/.befund-quelle" 2>/dev/null || true
RAN=0
NEUSTART=0

for mod in $(steps_list); do
	name="$(basename "$mod" .sh)"

	if [ -n "$ONLY" ]; then
		case "$name" in
			"$ONLY"|"$ONLY"-*) : ;;
			*) continue ;;
		esac
	fi

	RAN=$((RAN + 1))
	_log_raw "--- Modul $name ---"

	# Betriebsart wird an das Modul durchgereicht; Module, die sie nicht
	# kennen, ignorieren sie.
	set +e
	CHIMERA_MODE="$MODE" CHIMERA_LOGFILE="$CHIMERA_LOGFILE" sh "$mod"
	rc=$?
	set -e

	if [ "$rc" -eq 4 ]; then
		# I8: source/ wurde erneuert. Ab jetzt arbeitet der Installer aus
		# source/, nicht aus dem Startbaum. Der Merker verhindert eine
		# Schleife: Meldet 00 auch im Neustart 4, ist etwas kaputt.
		if [ "${CHIMERA_NEU_GESTARTET:-0}" = 1 ]; then
			err "Modul $name meldet auch nach dem Neustart eine neue Quelle -- Abbruch."
			log_close 2; exit 2
		fi
		_neu="$(rootpath "$CHIMERA_SOURCE")/installer/chimera-install"
		[ -f "$_neu" ] || { err "source/ ohne Installer ($_neu)."; log_close 2; exit 2; }
		_log_raw "Modul $name: source/ erneuert -- Neustart aus $_neu"
		log "Neustart aus $CHIMERA_SOURCE"
		log_close 0 >/dev/null
		CHIMERA_NEU_GESTARTET=1; export CHIMERA_NEU_GESTARTET
		# shellcheck disable=SC2086
		exec sh "$_neu" $ARGS_NEU
	elif [ "$rc" -eq 0 ]; then
		_log_raw "Modul $name: ok"
	elif [ "$rc" -eq 3 ]; then
		# 3 heisst: eingerichtet, aber der Nachweis gelingt erst nach
		# einem Neustart (Overlay und Kernelmodul laden beim Start).
		# Das ist KEIN Abbruch und KEIN Fehler -- genau darum geht es
		# bei I7. Vorher endete der Lauf hier, und auf einer frischen
		# Installation kam er damit nie ueber die Anzeige hinaus.
		NEUSTART=1
		_log_raw "Modul $name: rc 3 -- Neustart noetig"
	elif [ "$rc" -eq 1 ]; then
		# Befund: nichts zu tun, oder die Umgebung ist unvollstaendig.
		# Kein Profil, aber der Lauf geht weiter (Regel 10k).
		FAILED=$((FAILED + 1))
		[ "$FIRST_RC" -eq 0 ] && FIRST_RC=1
		_log_raw "Modul $name: Befund (rc 1)"
	else
		# Ab 2 hat das Modul den Lauf bewusst beendet -- etwa weil eine
		# Voraussetzung fehlt oder niemand die Warnung bestaetigt hat.
		FAILED=$((FAILED + 1))
		[ "$FIRST_RC" -eq 0 ] && FIRST_RC=$rc
		_log_raw "Modul $name: Exitcode $rc"
		err "Modul $name bricht den Lauf ab (Exitcode $rc)."
		log_close "$rc"
		exit "$rc"
	fi
done

if [ "$RAN" -eq 0 ]; then
	err "Kein Modul ausgefuehrt${ONLY:+ -- kein Treffer fuer '$ONLY'}."
	log_close 2
	exit 2
fi

log ""
if [ "$FAILED" -eq 0 ] && [ "$NEUSTART" -eq 0 ]; then
	log "Fertig: $RAN Modul(e), ohne Fehler."
	ENDE_RC=0
elif [ "$FAILED" -eq 0 ]; then
	# Alles eingerichtet, aber etwas davon wird erst nach einem Neustart
	# nachweisbar. Der Wunsch wird EINMAL gemeldet, hier am Ende -- nicht
	# je Modul, das ihn aeussert.
	log "Fertig: $RAN Modul(e), ohne Fehler."
	warn "Ein Neustart steht aus: Ein Schritt ist eingerichtet, sein"
	warn "Nachweis gelingt aber erst nach dem Start."
	warn ""
	warn "  sudo reboot"
	warn ""
	warn "Danach den Lauf wiederholen -- erst dann ist er fertig."
	ENDE_RC=3
else
	warn "Fertig: $RAN Modul(e), $FAILED mit Befund."
	[ "$NEUSTART" -eq 1 ] && \
		warn "Ausserdem steht ein Neustart aus (wird erst nach Fehlern gemeldet)."
	ENDE_RC="$FIRST_RC"
fi
log_close "$ENDE_RC"
exit "$ENDE_RC"
