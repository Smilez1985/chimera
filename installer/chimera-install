#!/bin/sh
# Chimera -- Installer, Haupteinstieg.
#
# Ruft die Schritte in `steps/` der Nummer nach auf. Jeder Lauf schreibt
# ein Protokoll, auch ein erfolgreicher.
#
# Aufruf:
#   chimera-install                  alle Module
#   chimera-install --only 10        nur Modul 10 (Praefix genuegt)
#   chimera-install --hardware       nur die Hardware-Module (40 45 50):
#                                    der Boot-Abgleich (chimera-hardware.service)
#                                    nach einem Kartentausch (DESIGN 6e)
#   chimera-install --list           Module auflisten
#   chimera-install --dry-run        nur berichten, nichts aendern
#   chimera-install --check          Zustand pruefen, Exitcode sprechend
#   chimera-install --log-dir DIR    Ablage des Protokolls
#
# Abgekoppelt: Die Arbeit laeuft als eigene Unit "chimera-installhelper"
# (DESIGN, Regel "Installerhelfer"). Ein Abbruch der SSH-Sitzung beendet den Lauf
# damit nicht, und der Lauf sitzt nicht in der cgroup von ssh.service. Das
# interne --helfer fuehrt die Arbeit direkt aus (so ruft sich der Lauf selbst).
#
# Exitcode: der des ersten fehlgeschlagenen Moduls, sonst 0.
#           Stand ein Schritt auf "Neustart noetig" und war sonst alles in
#           Ordnung, ist es 3 -- fertig ist der Lauf dann naemlich nicht.
#           Ein echter Fehler schlaegt den Neustartwunsch.

set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/common.sh"

MODE=run
ONLY=""
HARDWARE=0
HELFER_AUFTRAG=0
# Der Startbaum ist das Repo, aus dem dieser Lauf gestartet wurde (fuer den
# Vergleich "aendert sich etwas?").
: "${CHIMERA_STARTBAUM:=$(cd "$HERE/.." && pwd)}"
VERSION="$(cat "$HERE/../VERSION" 2>/dev/null || echo '?')"

usage() {
	cat <<EOF
chimera-install $VERSION

  --only <praefix>   nur das passende Modul (z. B. 10, oder 10-check-system)
  --hardware         nur Hardware-Module (40 45 50) -- Boot-Abgleich
  --list             verfuegbare Module anzeigen
  --dry-run          nichts aendern, nur berichten
  --check            nur pruefen, Exitcode sagt den Zustand
  --log-dir <dir>    wohin das Protokoll geschrieben wird
  --downgrade=true   aelteren Stand bewusst nach source/ uebernehmen
  --mit <gruppe>     Opt-in-Recht fuer den Dienstnutzer (i2c, video)
  -h, --help         diese Hilfe
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--only)    ONLY="${2:?--only braucht einen Wert}"; shift 2 ;;
		--hardware) HARDWARE=1; shift ;;
		--dry-run) MODE=dry;   shift ;;
		--check)   MODE=check; shift ;;
		--list)    MODE=list;  shift ;;
		--log-dir) CHIMERA_LOG_DIR="${2:?--log-dir braucht einen Wert}"; shift 2 ;;
		--downgrade=true)  CHIMERA_DOWNGRADE=true; shift ;;
		--downgrade=false) CHIMERA_DOWNGRADE=false; shift ;;
		--mit)
			case "${2:-}" in
				i2c|video) CHIMERA_MIT="${CHIMERA_MIT:+$CHIMERA_MIT }$2" ;;
				*) err "--mit kennt nur: i2c video"; exit 2 ;;
			esac
			shift 2 ;;
		--helfer) HELFER_AUFTRAG=1; shift ;;
		-h|--help) usage; exit 0 ;;
		*) err "Unbekannte Option: $1"; usage >&2; exit 2 ;;
	esac
done

export CHIMERA_DOWNGRADE="${CHIMERA_DOWNGRADE:-false}" CHIMERA_MIT="${CHIMERA_MIT:-}"

# Der Helfer liest die Umgebung, die der Aufruf ihm hinterlassen hat.
. "$HERE/lib/source.sh"
. "$HERE/lib/python.sh"
. "$HERE/lib/helfer.sh"
. "$HERE/lib/fortschritt.sh"
# Nur fuer vorab_an(): Der Schalter CHIMERA_PREFETCH_RAD wird an EINER Stelle
# gelesen (lib/vorab.sh), damit Installer und Prefetch-Prozess nie
# verschiedener Meinung sind.
. "$HERE/lib/vorab.sh"
if [ "$HELFER_AUFTRAG" = 1 ]; then
	helfer_env_lesen
	# Laufzettel: Der Helfer meldet selbst, dass er laeuft und wie er endet.
	# Noetig, weil die transiente Unit am Pi nach dem Start nicht abfragbar ist.
	_hel_start="$(date +%s)"
	helfer_zettel_schreiben laufend "$$" "" "$_hel_start"
	_helfer_ende() {
		helfer_zettel_schreiben fertig "" "${1:-0}" "$_hel_start"
	}
	trap '_helfer_ende 2' INT TERM
fi

# Die Argumente fuer den Neustart aus source/ (I8) festhalten -- nach der
# Schleife oben sind sie verbraucht.
ARGS_NEU=""
[ "$MODE" = dry ] && ARGS_NEU="$ARGS_NEU --dry-run"
[ "$MODE" = check ] && ARGS_NEU="$ARGS_NEU --check"
[ -n "$ONLY" ] && ARGS_NEU="$ARGS_NEU --only $ONLY"
[ "$HARDWARE" = 1 ] && ARGS_NEU="$ARGS_NEU --hardware"
# Auch der Helferauftrag muss den Neustart ueberleben. Ohne --helfer laeuft der
# neue Prozess als gewoehnlicher Lauf und schreibt den Laufzettel nie zu Ende --
# der Aufrufer wartet dann auf "fertig", das nie kommt (am Pi 2.11. so).
[ "$HELFER_AUFTRAG" = 1 ] && ARGS_NEU="$ARGS_NEU --helfer"

steps_list() {
	# Nummerisch sortiert, damit 10 vor 90 kommt.
	find "$HERE/steps" -name '[0-9]*-*.sh' 2>/dev/null | sort
}

if [ "$MODE" = list ]; then
	printf 'Verfuegbare Module:\n'
	steps_list | while read -r m; do printf '  %s\n' "$(basename "$m" .sh)"; done
	exit 0
fi

# Abkoppeln: Ein echter Lauf, der nicht schon der Helfer ist, wird als eigene
# Unit gestartet. Bei --list, --dry-run und --check bleibt er hier: Sie aendern
# nichts und brauchen keine eigene Unit.
# Nur der Helfer fuehrt die Arbeit aus; jeder andere Aufruf reicht sie weiter.
# Auch ohne root: Dann wird der Lauf abgelehnt statt in der Sitzung zu laufen --
# sonst haenge das Ergebnis davon ab, wie jemand den Installer aufruft (Regel
# "Installerhelfer", Punkt 1).
if [ "$MODE" = run ] && [ "$HELFER_AUFTRAG" != 1 ] && [ "${CHIMERA_HELFER:-0}" != 1 ]; then
	if [ "$(id -u)" != 0 ]; then
		err "Dieser Lauf braucht root -- und er laeuft nie in der aufrufenden Sitzung."
		err "  sudo sh $0 $*"
		exit 2
	fi
	_ah_neu=""
	[ -n "$ONLY" ] && _ah_neu="$_ah_neu --only $ONLY"
	[ "$HARDWARE" = 1 ] && _ah_neu="$_ah_neu --hardware"
	[ "$CHIMERA_DOWNGRADE" = true ] && _ah_neu="$_ah_neu --downgrade=true"
	[ -n "$CHIMERA_MIT" ] && _ah_neu="$_ah_neu --mit $(printf '%s' "$CHIMERA_MIT" | tr ' ' '\n' | head -1)"
	# shellcheck disable=SC2086
	helfer_starten "$HERE/chimera-install" $_ah_neu
	exit $?
fi

log_open "install" || warn "Kein Protokoll moeglich -- Lauf wird nicht festgehalten."

log "chimera-install $VERSION"
case "$MODE" in
	dry)   info "Trockenlauf -- es wird nichts geaendert." ;;
	check) info "Pruefung -- es wird nichts geaendert." ;;
esac
[ -n "$ONLY" ] && info "Nur Modul: $ONLY"
[ "$HARDWARE" = 1 ] && info "Boot-Abgleich: nur Hardware-Module (40 45 50)"
log ""

FAILED=0
FIRST_RC=0
# Ein Befund aus Schritt 00 vor dem Neustart (aelterer Startbaum abgelehnt)
# zaehlt mit -- sonst verschwaende er im exec (stiller Erfolg).
if [ -f "$CHIMERA_LOG_DIR/.befund-quelle" ] && [ "${CHIMERA_NEU_GESTARTET:-0}" = 1 ]; then
	warn "Quelle: $(cat "$CHIMERA_LOG_DIR/.befund-quelle")"
	FAILED=1; FIRST_RC=1
fi
rm -f "$CHIMERA_LOG_DIR/.befund-quelle" 2>/dev/null || true
RAN=0
NEUSTART=0

# Klammer: Dateien nicht unter einem laufenden Dienst ersetzen. Nur im Helfer
# (also in einem echten, abgekoppelten Lauf) und nicht beim Boot-Abgleich: Der
# laeuft, bevor die Dienste starten, und darf den Dienst nicht anhalten, der
# auf ihn wartet (gemessen: Job canceled).
_KLAMMER=0
if helfer_laeuft && [ "$MODE" = run ] && [ "$HARDWARE" != 1 ]; then
	if klammer_noetig; then
		klammer_an || { log_close 2; exit 2; }
		_KLAMMER=1
	else
		info "Kein neuer Stand und alle Abhaengigkeiten erfuellt -- Dienste laufen weiter, nichts wird angefasst."
	fi
fi

# Der Neustart per exec hat eine offene Klammer hinterlassen: Der neue Prozess
# schliesst sie am Ende, statt sie zu vergessen (Merker liegt im Laufverzeichnis).
if [ "${CHIMERA_KLAMMER:-0}" = 1 ] && [ -f "$(_klammer_datei)" ]; then
	_KLAMMER=1
	info "Offene Klammer aus dem Neustart uebernommen -- Dienste werden am Ende wieder gestartet."
fi

# Fortschrittsanzeige: Jede Stufe zaehlt gleich viel (Vorgabe smilez, 2.11.).
# Sie laeuft nur in einem vollen Lauf, in dem die Dienste angehalten sind --
# dann ist das Panel frei und der Dienst kann es ohnehin nicht bedienen.
# Bei --only gibt es nichts zu verteilen, beim Boot-Abgleich bleibt der Dienst an.
_FORT_VORHANDEN=0
if [ "$_KLAMMER" = 1 ] && [ -z "$ONLY" ] && [ "$HARDWARE" != 1 ]; then
	_FORT_VORHANDEN=1
	_FORT_GESAMT_VORLAUF="$(steps_list | wc -l | tr -d ' ')"
	fortschritt_start "$_FORT_GESAMT_VORLAUF"
fi

# Vorab-Laden im Hintergrund (DESIGN, Regel "Warte-Schleife und Vorab-Laden"):
# Bevor der erste Schritt laeuft, kennt der Lauf seine Downloads bereits. Ein
# abgekoppelter Helfer holt sie in Modulreihenfolge, waehrend hier gearbeitet
# wird -- apt-.deb zuerst, damit der Netzanteil aus Modul 20 herausfaellt.
# Nur im vollen Lauf: Bei --only und beim Boot-Abgleich waere die Vorhersage
# falsch, und ein zweiter Lauf neben dem ersten braucht sie nicht.
if [ "$MODE" = run ] && [ -z "$ONLY" ] && [ "$HARDWARE" != 1 ] && \
   [ "${CHIMERA_NEU_GESTARTET:-0}" != 1 ]; then
	# Eigene Unit, nicht `nohup ... &`: sonst haengt der Vorab-Lader in der
	# Cgroup dieses Laufs und wird bei dessen Ende abgeraeumt (5.11. am Pi:
	# mitten im Download erschossen, keine Marke). Siehe lib/vorab.sh.
	_vorab_rc=0
	vorab_starten "$HERE/chimera-prefetch" || _vorab_rc=$?
	case "$_vorab_rc" in
		0) info "Vorab-Laden laeuft im Hintergrund (chimera-prefetch)." ;;
		2) info "Vorab-Laden ist abgeschaltet (CHIMERA_PREFETCH_RAD=0)." ;;
		*) warn "Vorab-Laden konnte nicht gestartet werden -- die Schritte laden selbst." ;;
	esac
fi

for mod in $(steps_list); do
	name="$(basename "$mod" .sh)"

	if [ -n "$ONLY" ]; then
		case "$name" in
			"$ONLY"|"$ONLY"-*) : ;;
			*) continue ;;
		esac
	fi
	# Boot-Abgleich: nur, was von der angeschlossenen Hardware abhaengt.
	# Kein Schritt 00 (kein Netzabgleich beim Start), kein 98 (der Dienst
	# startet danach ohnehin -- die Unit haengt an dieser).
	if [ "$HARDWARE" = 1 ]; then
		case "$name" in
			40-*|45-*|50-*) : ;;
			*) continue ;;
		esac
	fi

	RAN=$((RAN + 1))
	_log_raw "--- Modul $name ---"
	# Dauer je Modul (Regel "Warte-Schleife und Vorab-Laden", Phase P1):
	# Ohne diese Zahlen ist jede
	# Reihenfolge beim Vorab-Laden geraten. BusyBox und GNU date koennen +%s.
	_MOD_T0=$(date +%s)

	# Betriebsart wird an das Modul durchgereicht; Module, die sie nicht
	# kennen, ignorieren sie.
	# Schritte, die das Panel selbst brauchen, bekommen es frei: Sonst meldet
	# die Anzeige-Erkennung "Leitungen belegt" (am Pi 2.11. gemessen).
	_FORT_PAUSIERT=0
	# Nur Schritt 40 oeffnet das Panel selbst -- und auch das nur, wenn er
	# wirklich erkennen muss. Ist die Anzeige schon eingerichtet (state/anzeige
	# und /dev/spidev0.0), bricht er sofort ab. Dann bliebe das Panel bei einer
	# Pause unnoetig dunkel: Beim Prozessende gibt der Kernel die GPIO-Leitung
	# frei, und das Hintergrundlicht geht aus (am Geraet gesehen, 2.11.).
	case "$name" in
		40-*)
			if [ "$_FORT_VORHANDEN" = 1 ] && \
			   { [ ! -f "$(rootpath "$CHIMERA_OPT")/state/anzeige" ] || \
			     [ ! -e /dev/spidev0.0 ]; }; then
				info "Anzeige: Pause -- Schritt 40 muss das Panel selbst pruefen."
				fortschritt_halt
				_FORT_PAUSIERT=1
			fi ;;
	esac
	set +e
	CHIMERA_MODE="$MODE" CHIMERA_LOGFILE="$CHIMERA_LOGFILE" CHIMERA_KLAMMER="$_KLAMMER" sh "$mod"
	rc=$?
	set -e

	_MOD_D=$(( $(date +%s) - _MOD_T0 ))
	_log_raw "Modul $name brauchte ${_MOD_D}s"

	if [ "$_FORT_PAUSIERT" = 1 ]; then
		fortschritt_start "$_FORT_GESAMT_VORLAUF" "$RAN"
		_FORT_PAUSIERT=0
	fi

	if [ "$_FORT_VORHANDEN" = 1 ]; then
		fortschritt_setze "$RAN"
	fi

	if [ "$rc" -eq 4 ]; then
		# I8: source/ wurde erneuert. Ab jetzt arbeitet der Installer aus
		# source/, nicht aus dem Startbaum. Der Merker verhindert eine
		# Schleife: Meldet 00 auch im Neustart 4, ist etwas kaputt.
		if [ "${CHIMERA_NEU_GESTARTET:-0}" = 1 ]; then
			err "Modul $name meldet auch nach dem Neustart eine neue Quelle -- Abbruch."
			log_close 2; exit 2
		fi
		_neu="$(rootpath "$CHIMERA_SOURCE")/installer/chimera-install"
		[ -f "$_neu" ] || { err "source/ ohne Installer ($_neu)."; log_close 2; exit 2; }
		_log_raw "Modul $name: source/ erneuert -- Neustart aus $_neu"
		log "Neustart aus $CHIMERA_SOURCE"
		log_close 0 >/dev/null
		CHIMERA_NEU_GESTARTET=1; export CHIMERA_NEU_GESTARTET
		# shellcheck disable=SC2086
		# Klammer und Protokoll muessen den Neustart ueberleben: Der neue Prozess
		# arbeitet unter dem angehaltenen Dienst weiter und muss ihn danach
		# wieder starten -- sonst bliebe der Merker liegen und niemand
		# protokollierte den Start.
		# Der Zeichner laeuft weiter: Der neue Prozess uebernimmt ihn (gleiche
		# PID-Datei), statt ihn anzuhalten und neu zu starten. Jedes Anhalten
		# macht das Display dunkel, weil der Kernel die GPIO-Leitung freigibt.
		CHIMERA_LOGFILE_FORTSETZEN="$CHIMERA_LOGFILE"; export CHIMERA_LOGFILE_FORTSETZEN
		[ "$_KLAMMER" = 1 ] && { CHIMERA_KLAMMER=1; export CHIMERA_KLAMMER; }
		if [ "$HELFER_AUFTRAG" = 1 ]; then
			CHIMERA_HELFER=1 exec sh "$_neu" $ARGS_NEU
		else
			exec sh "$_neu" $ARGS_NEU
		fi
	elif [ "$rc" -eq 0 ]; then
		_log_raw "Modul $name: ok"
	elif [ "$rc" -eq 3 ]; then
		# 3 heisst: eingerichtet, aber der Nachweis gelingt erst nach
		# einem Neustart (Overlay und Kernelmodul laden beim Start).
		# Das ist KEIN Abbruch und KEIN Fehler -- genau darum geht es
		# bei I7. Vorher endete der Lauf hier, und auf einer frischen
		# Installation kam er damit nie ueber die Anzeige hinaus.
		NEUSTART=1
		_log_raw "Modul $name: rc 3 -- Neustart noetig"
	elif [ "$rc" -eq 1 ]; then
		# Befund: nichts zu tun, oder die Umgebung ist unvollstaendig.
		# Kein Profil, aber der Lauf geht weiter (Regel 10k).
		FAILED=$((FAILED + 1))
		[ "$FIRST_RC" -eq 0 ] && FIRST_RC=1
		_log_raw "Modul $name: Befund (rc 1)"
	else
		# Ab 2 hat das Modul den Lauf bewusst beendet -- etwa weil eine
		# Voraussetzung fehlt oder niemand die Warnung bestaetigt hat.
		FAILED=$((FAILED + 1))
		[ "$FIRST_RC" -eq 0 ] && FIRST_RC=$rc
		_log_raw "Modul $name: Exitcode $rc"
		err "Modul $name bricht den Lauf ab (Exitcode $rc)."
		if [ "$_KLAMMER" = 1 ]; then
			klammer_aus || true
		fi
		log_close "$rc"
		exit "$rc"
	fi
done

# Bei einem echten Fehler (rc 2 oder mehr) steigt Mojo ein: Es prueft die
# Dienste, Sockets und den Speicher und repariert, was es reparieren kann
# (Vorgabe smilez, 2.11.). Ein Befund (rc 1) loest das nicht aus -- sonst
# liefe Mojo nach jedem Lauf, in dem nur etwas fehlt.
if [ "$FIRST_RC" -ge 2 ] && [ -x "$(rootpath "$CHIMERA_OPT")/bin/chimera-tor" ]; then
	if have_cmd systemd-run; then
		systemd-run --unit=chimera-mojo-install --collect --no-block --quiet \
			"$(rootpath "$CHIMERA_OPT")/bin/chimera-tor" --mojo --miracle \
			>/dev/null 2>&1 && info "Mojo steigt ein (chimera-mojo-install)." || \
			warn "Mojo konnte nicht gestartet werden."
	else
		"$(rootpath "$CHIMERA_OPT")/bin/chimera-tor" --mojo --miracle >/dev/null 2>&1 || true
	fi
fi

if [ "$_FORT_VORHANDEN" = 1 ]; then
	# Ergebnis ans Abschlusszeichen: gruen bei Erfolg, rot SOS bei Befund oder
	# Fehler (Vorgabe smilez, 2.11.).
	# Vier Ausgaenge, vier Bilder -- ein ausstehender Neustart ist kein
	# Fehler, und ein Befund ist keiner (Vorgabe smilez, 3.11.).
	if [ "$FAILED" -ne 0 ]; then
		if [ "$FIRST_RC" -le 1 ]; then
			fortschritt_ergebnis befund
		else
			fortschritt_ergebnis fehler
		fi
	elif [ "$NEUSTART" -eq 1 ]; then
		fortschritt_ergebnis neustart
	else
		fortschritt_ergebnis ok
	fi
	fortschritt_stop
fi

_HATTE_KLAMMER="$_KLAMMER"
if [ "$_KLAMMER" = 1 ]; then
	klammer_aus || { [ "$FAILED" -eq 0 ] && { FAILED=1; FIRST_RC=1; }; }
	_KLAMMER=0
fi

if [ "$RAN" -eq 0 ]; then
	err "Kein Modul ausgefuehrt${ONLY:+ -- kein Treffer fuer '$ONLY'}."
	log_close 2
	exit 2
fi

log ""
if [ "$FAILED" -eq 0 ] && [ "$NEUSTART" -eq 0 ]; then
	log "Fertig: $RAN Modul(e), ohne Fehler."
	ENDE_RC=0
elif [ "$FAILED" -eq 0 ]; then
	# Alles eingerichtet, aber etwas davon wird erst nach einem Neustart
	# nachweisbar. Der Wunsch wird EINMAL gemeldet, hier am Ende -- nicht
	# je Modul, das ihn aeussert.
	log "Fertig: $RAN Modul(e), ohne Fehler."
	warn "Ein Neustart steht aus: Ein Schritt ist eingerichtet, sein"
	warn "Nachweis gelingt aber erst nach dem Start."
	warn ""
	warn "  sudo reboot"
	warn ""
	warn "Danach den Lauf wiederholen -- erst dann ist er fertig."
	ENDE_RC=3
else
	warn "Fertig: $RAN Modul(e), $FAILED mit Befund."
	[ "$NEUSTART" -eq 1 ] && \
		warn "Ausserdem steht ein Neustart aus (wird erst nach Fehlern gemeldet)."
	ENDE_RC="$FIRST_RC"
fi
# --- Abschluss an die LED -------------------------------------------------
#
# Jeder Ausgang bekommt seine eigene Anzeige (Vorgabe smilez, 3.11.): ein
# Lauf, der nichts zu tun hatte, ist ein Erfolg und muss auch so aussehen --
# sonst leuchtet nach jedem "alles aktuell" gar nichts.
#
#   ok        gruen, fest               eingerichtet, alles neu
#   nichts    gruen, langsam blinkend   geprueft, nichts zu tun
#   befund    gelb, fest                geschafft, etwas fehlt
#   neustart  blau, blinkend            wirkt erst nach dem Start
#   fehler    rot, SOS                  abgebrochen
#
# Laeuft der Dienst (Fall "nichts zu tun"), haelt er die Leitungen der LED --
# dann kann der Installer sie nicht selbst setzen, er meldet den Ausgang
# ueber den Sitzungs-Socket, und der Renderer setzt die Farbe in seinem Takt.
if [ "$MODE" = run ] && [ "$HELFER_AUFTRAG" = 1 ]; then
	if [ "$FAILED" -ne 0 ]; then
		if [ "$FIRST_RC" -le 1 ]; then _led_zustand=befund; else _led_zustand=fehler; fi
	elif [ "$NEUSTART" -eq 1 ]; then
		_led_zustand=neustart
	elif [ "$_HATTE_KLAMMER" = 1 ]; then
		_led_zustand=ok
	else
		_led_zustand=nichts
	fi
	_led_py="$(_fort_py 2>/dev/null || true)"
	_led_skript="$HERE/lib/py/led.py"
	_led_sock="${CHIMERA_SITZUNG_SOCKET:-/run/chimera/sitzung.sock}"
	[ -n "$_led_sock" ] || _led_sock="$(rootpath /run/chimera/sitzung.sock)"
	if [ -n "$_led_py" ] && [ -f "$_led_skript" ]; then
		if "$_led_py" "$_led_skript" "$(rootpath "$_led_sock")" "$_led_zustand" >>"$CHIMERA_LOGFILE" 2>&1; then
			log "Anzeige: LED: $_led_zustand"
		else
			info "Anzeige: LED nicht gemeldet (kein Dienst am Socket) -- Ausgang: $_led_zustand"
		fi
	fi
fi

if [ "$HELFER_AUFTRAG" = 1 ]; then
	helfer_zettel_schreiben fertig "" "$ENDE_RC" "$_hel_start"
fi
log_close "$ENDE_RC"
exit "$ENDE_RC"
